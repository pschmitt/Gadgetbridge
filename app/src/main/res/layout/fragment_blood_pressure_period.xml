<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/bp_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/date_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="@dimen/chart_section_spacing"
                android:gravity="center"
                android:textColor="?attr/textColorPrimary"
                android:textSize="20sp" />

            <nodomain.freeyourgadget.gadgetbridge.activities.workouts.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sectionTitle="@string/blood_pressure_daily" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="250sp">

                <nodomain.freeyourgadget.gadgetbridge.activities.charts.mpchart.GbChartView
                    android:id="@+id/blood_pressure_chart"
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_weight="2" />
            </LinearLayout>

            <nodomain.freeyourgadget.gadgetbridge.activities.charts.mpchart.ChartLegendView
                android:id="@+id/blood_pressure_period_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/bp_stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:orientation="vertical" />
        </LinearLayout>

    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/bp_export_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/appmanager_app_share"
        app:srcCompat="@drawable/ic_share" />

</RelativeLayout>