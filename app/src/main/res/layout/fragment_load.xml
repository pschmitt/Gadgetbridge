<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/date_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="20sp"
            android:textColor="?attr/textColorPrimary"
            android:layout_marginTop="15dp"
            />

        <LinearLayout
            android:id="@+id/training_load_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="-7dp"
                android:orientation="vertical"
                >

                <ImageView
                    android:id="@+id/acute_load_ratio_gauge"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_centerHorizontal="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/acute_load_ratio_gauge"
                    android:layout_alignBottom="@id/acute_load_ratio_gauge"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/acute_load_ratio_gauge_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/stats_empty_value"
                        android:textColor="?attr/textColorPrimary"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/acute_load_ratio_gauge_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-4dp"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="?attr/textColorSecondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </RelativeLayout>

            <nodomain.freeyourgadget.gadgetbridge.activities.workouts.SectionHeaderView
                android:id="@+id/acute_load_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sectionTitle="@string/training_acute_load" />
            <nodomain.freeyourgadget.gadgetbridge.activities.charts.mpchart.GbChartView
                android:id="@+id/acute_load_chart"
                android:layout_width="fill_parent"
                android:layout_height="250sp"
                android:layout_weight="2" />
            <nodomain.freeyourgadget.gadgetbridge.activities.charts.mpchart.ChartLegendView
                android:id="@+id/acute_load_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <nodomain.freeyourgadget.gadgetbridge.activities.charts.ChartChipScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/load_chart_data_type_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    android:layout_marginBottom="10dp"
                    app:selectionRequired="true" />

            </nodomain.freeyourgadget.gadgetbridge.activities.charts.ChartChipScrollView>

            <LinearLayout
                android:id="@+id/acute_chronic_load_stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:orientation="vertical" />
        </LinearLayout>

        <nodomain.freeyourgadget.gadgetbridge.activities.workouts.SectionHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chart_section_spacing"
            app:sectionTitle="@string/training_daily_load" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250sp">
            <nodomain.freeyourgadget.gadgetbridge.activities.charts.mpchart.GbChartView
                android:id="@+id/daily_load_chart"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/weekly_load_stats_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
