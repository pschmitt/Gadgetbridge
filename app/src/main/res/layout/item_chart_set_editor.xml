<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/set_swatch"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_chart_set_swatch" />

        <TextView
            android:id="@+id/set_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/set_field"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chart_metric_field"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            app:drawableEndCompat="@drawable/ic_arrow_drop_down_chart"
            app:drawableTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/set_type"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/set_type_bar"
                style="@style/Widget.App.ChartTypeSegment"
                android:layout_width="46dp"
                android:layout_height="48dp"
                android:contentDescription="@string/statistics_chart_type_bar"
                app:icon="@drawable/ic_bar_chart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/set_type_line"
                style="@style/Widget.App.ChartTypeSegment"
                android:layout_width="46dp"
                android:layout_height="48dp"
                android:contentDescription="@string/statistics_chart_type_line"
                app:icon="@drawable/ic_show_chart" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <TextView
        android:id="@+id/set_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/statistics_chart_average_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
