<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_item_root"
    style="@style/DeviceCardActionBox"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/card_item_icon"
        style="@style/DeviceCardActionIcon"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_device_unknown" />

    <TextView
        android:id="@+id/card_item_label"
        style="@style/DeviceCardActionLabel"
        android:visibility="gone"
        tools:text="100%"
        tools:visibility="visible" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/card_item_busy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackCornerRadius="2dp"
        app:trackThickness="3dp"
        tools:visibility="visible" />

</LinearLayout>
