<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_battery_info_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:clipToPadding="false"
    android:paddingBottom="20dp"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/activity_battery_info_master_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="20dp">

            <ImageView
                android:id="@+id/battery_status_device_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/device_card_icon_bg"
                android:contentDescription="@string/candidate_item_device_image"
                android:paddingLeft="2dp"
                android:paddingTop="2dp"
                android:scaleType="fitCenter"
                android:theme="@style/ThemeOverlay.App.DeviceCardIcon"
                app:srcCompat="@drawable/ic_devices_other"
                tools:ignore="RtlHardcoded" />

            <LinearLayout
                android:id="@+id/activity_battery_info_top_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/battery_status_device_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Device name" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/battery_status_connection_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/device_status_dot" />

                    <TextView
                        android:id="@+id/battery_status_connection_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/textColorSecondary"
                        tools:text="@string/connected" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/battery_status_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/battery_status_extra_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:textColor="?attr/textColorSecondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/battery_status_battery_voltage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/textColorSecondary"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/battery_status_battery_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="?attr/textColorPrimary"
                android:textSize="36sp"
                tools:text="90%" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/activity_battery_info_bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/batteryChartFragmentHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">

            <SeekBar
                android:id="@+id/battery_status_time_span_seekbar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:max="5"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:progressDrawable="@drawable/battery_range_slider_track"
                android:splitTrack="false"
                android:thumb="@drawable/battery_range_slider_thumb"
                android:tickMark="@drawable/battery_range_slider_tick"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 52dp is twice the slider's side padding, so a bias of stop / 5 centres each label on its tick -->
            <TextView
                android:id="@+id/battery_range_stop_day"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:text="@string/duration_short_day"
                android:textColor="?attr/textColorSecondary"
                android:textSize="11sp"
                android:translationY="-14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/battery_status_time_span_seekbar" />

            <TextView
                android:id="@+id/battery_range_stop_week"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:text="@string/duration_short_week"
                android:textColor="?attr/textColorSecondary"
                android:textSize="11sp"
                android:translationY="-14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/battery_status_time_span_seekbar" />

            <TextView
                android:id="@+id/battery_range_stop_two_weeks"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:text="@string/duration_short_two_weeks"
                android:textColor="?attr/textColorSecondary"
                android:textSize="11sp"
                android:translationY="-14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/battery_status_time_span_seekbar" />

            <TextView
                android:id="@+id/battery_range_stop_month"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:text="@string/duration_short_month"
                android:textColor="?attr/textColorSecondary"
                android:textSize="11sp"
                android:translationY="-14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.6"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/battery_status_time_span_seekbar" />

            <TextView
                android:id="@+id/battery_range_stop_six_months"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:text="@string/duration_short_six_months"
                android:textColor="?attr/textColorSecondary"
                android:textSize="11sp"
                android:translationY="-14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.8"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/battery_status_time_span_seekbar" />

            <TextView
                android:id="@+id/battery_range_stop_year"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:text="@string/duration_short_year"
                android:textColor="?attr/textColorSecondary"
                android:textSize="11sp"
                android:translationY="-14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/battery_status_time_span_seekbar" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/stat_tile_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/stat_tile_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp"
                    android:paddingEnd="10dp"
                    android:paddingStart="10dp"
                    android:paddingTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_filter_date_from"
                        android:textColor="?attr/textColorSecondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/battery_status_date_from_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="?attr/textColorPrimary"
                        android:textSize="16sp"
                        tools:text="Sep 25" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/stat_tile_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/stat_tile_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp"
                    android:paddingEnd="10dp"
                    android:paddingStart="10dp"
                    android:paddingTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_detail_duration_label"
                        android:textColor="?attr/textColorSecondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/battery_status_time_span_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="?attr/textColorPrimary"
                        android:textSize="16sp"
                        tools:text="Two weeks" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/stat_tile_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/stat_tile_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/battery_status_date_to_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingBottom="12dp"
                    android:paddingEnd="10dp"
                    android:paddingStart="10dp"
                    android:paddingTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_filter_date_to"
                        android:textColor="?attr/textColorSecondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/battery_status_date_to_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="?attr/textColorPrimary"
                        android:textSize="16sp"
                        tools:text="Oct 9" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
