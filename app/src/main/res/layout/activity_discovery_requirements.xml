<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context="nodomain.freeyourgadget.gadgetbridge.activities.discovery.DiscoveryRequirementsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/discovery_requirements_icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_bluetooth_disabled" />

        <TextView
            android:id="@+id/discovery_requirements_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            tools:text="@string/bluetooth_is_disabled_" />

        <TextView
            android:id="@+id/discovery_requirements_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="@string/discovery_enable_bluetooth" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/discovery_requirements_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            tools:text="@string/discovery_requirements_enable_bluetooth" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/discovery_requirements_secondary"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="@string/discovery_requirements_bluetooth_settings" />
    </LinearLayout>
</ScrollView>
