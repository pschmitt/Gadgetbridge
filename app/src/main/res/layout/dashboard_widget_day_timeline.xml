<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".widgets.impl.TodayWidget">

    <include layout="@layout/dashboard_widget_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <nodomain.freeyourgadget.gadgetbridge.activities.dashboard.DayTimelineView
            android:id="@+id/tile_day_timeline"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/tile_axis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal" />

    </LinearLayout>

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/tile_flow_legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="-6dp"
        app:flexWrap="wrap"
        app:justifyContent="flex_start" />

</LinearLayout>
