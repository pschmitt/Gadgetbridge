<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/device_type_picker_item_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/device_card_icon_bg"
        android:importantForAccessibility="no"
        android:padding="2dp"
        android:scaleType="fitXY"
        android:theme="@style/ThemeOverlay.App.DeviceCardIcon"
        tools:src="@drawable/ic_device_pebble" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/device_type_picker_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceListItem"
            tools:text="Pebble Time" />

        <TextView
            android:id="@+id/device_type_picker_item_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="Pebble · Watch" />

        <TextView
            android:id="@+id/device_type_picker_item_experimental"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_experimental"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorError" />

    </LinearLayout>

    <RadioButton
        android:id="@+id/device_type_picker_item_radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:clickable="false"
        android:focusable="false" />

</LinearLayout>
